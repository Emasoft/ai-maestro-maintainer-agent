# Development directories
*_dev/
docs_dev/
scripts_dev/

# Python
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.*

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Claude Code
.claude/

# LLM Externalizer
llm_externalizer_output/

# TLDR
.tldr/

# SERENA MCP state (local project metadata, not published)
.serena/

# git-cliff scratch — ephemeral release notes between bump and push
.git-cliff-release-notes.md

# Reports (both must stay gitignored — contain private paths, tokens, internal notes)
reports/
reports_dev/

# Janitor state (per-project session state from ai-maestro-janitor plugin)
.janitor/

# AI Maestro per-agent state — backed up + migrated by AI Maestro itself,
# never committed to the git repo. Includes:
#   .aimaestro/state/processed-issues.json
#   .aimaestro/state/branch-rules.json
#   .aimaestro/state/guardian-baseline.json
#   .aimaestro/state/guardian-state.json
#   .aimaestro/workspace-<sid>/   (per-session repo clone, regenerable)
.aimaestro/

# TLDR read-enforcer config
.tldrignore

# Rechecker plugin local state (operational telemetry, not reports)
.rechecker/
/.trashcan/*
!/.trashcan/.gitkeep
!/.trashcan/README.txt

# Added by CPV standardize
.coverage

# Backup files created by CPV standardize-plugin --force-templates
*.bak
